# Copy to .env for local development. On Vercel, add the same names under
# Project -> Settings -> Environment Variables.

# --- Required ---------------------------------------------------------------
# Neon connection string (Neon console -> Connect). Locally, use a dev branch.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Only used by `npm run db:migrate:prod` to migrate the production branch.
DATABASE_URL_PROD=""
# Signs login sessions. Generate: openssl rand -base64 32
AUTH_SECRET=""
# Encrypts everyone's Strava/Intervals.icu keys and personal links.
# Generate: openssl rand -base64 32   (never change it once people have joined)
ENCRYPTION_KEY=""
# Protects the daily sync. Generate: openssl rand -hex 24
CRON_SECRET=""

# --- Optional ---------------------------------------------------------------
# Your public address, e.g. https://tri.example.com (Vercel works without it).
AUTH_URL=""
# Name shown in the app, browser tab and installed phone app.
NEXT_PUBLIC_APP_NAME="Tri Tracker"
# "Sign in with Google" (Google Cloud console -> OAuth client, Web application).
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Strava (strava.com/settings/api). Authorization Callback Domain = your domain.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# AI coach. Leave empty to keep it switched off. Every question costs you money.
ANTHROPIC_API_KEY=""
# Max coach spend per person per day, in US cents (default 50).
COACH_DAILY_BUDGET_CENTS=""
